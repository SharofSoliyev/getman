<ResourceDictionary x:Class="GetMan.Themes.MotionResources"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared motion vocabulary. Everything hover related fades an Opacity or nudges a
        transform: both are plain doubles, so no frozen-brush surprises and the states
        compose cleanly when hover and selection overlap.

        Timings: 120ms in, 160ms out - fast enough to feel instant, slow enough to read.
    -->

    <!-- Durations live in resources so reduced-motion can zero them at start-up. -->
    <Duration x:Key="DurFast">0:0:0.13</Duration>
    <Duration x:Key="DurSlow">0:0:0.20</Duration>
    <Duration x:Key="DurPop">0:0:0.28</Duration>

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <CubicEase x:Key="EaseIn" EasingMode="EaseIn" />
    <QuadraticEase x:Key="EaseSoft" EasingMode="EaseOut" />
    <BackEase x:Key="EasePop" EasingMode="EaseOut" Amplitude="0.35" />

    <!-- x:Shared="False" hands every control its own transform instance to animate. -->
    <ScaleTransform x:Key="HoverScale" x:Shared="False" ScaleX="1" ScaleY="1" />
    <TranslateTransform x:Key="HoverSlide" x:Shared="False" X="0" Y="0" />

    <!-- ============================================ reusable storyboards ==== -->
    <Storyboard x:Key="FadeInFast">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <Storyboard x:Key="FadeOutFast">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

    <!-- Content arriving: rise a little while fading in. -->
    <Storyboard x:Key="RiseIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"
                         EasingFunction="{StaticResource EaseOut}" />
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" From="10" To="0" Duration="0:0:0.28"
                         EasingFunction="{StaticResource EaseOut}" />
    </Storyboard>

</ResourceDictionary>
