<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark tokens - the "Developer Tool / IDE" palette: a slate canvas with a green run
        action and a sky selection accent. Every colour in the app resolves through one of
        these keys, so Tokens.Light.xaml is a drop-in replacement.

        Contrast against Bg0 (#0F172A): Fg 16.4:1, FgDim 7.4:1, FgMuted 4.6:1.
    -->

    <!-- surfaces: canvas -> panel -> chrome -> hover -> selected -->
    <Color x:Key="Bg0Color">#FF0F172A</Color>
    <Color x:Key="Bg1Color">#FF16203A</Color>
    <Color x:Key="Bg2Color">#FF1E293B</Color>
    <Color x:Key="Bg3Color">#FF273548</Color>
    <Color x:Key="Bg4Color">#FF334155</Color>
    <Color x:Key="BorderSoftColor">#FF1E293B</Color>
    <Color x:Key="BorderColor">#FF334155</Color>

    <Color x:Key="TextColor">#FFF8FAFC</Color>
    <Color x:Key="TextDimColor">#FF94A3B8</Color>
    <Color x:Key="TextMutedColor">#FF64748B</Color>

    <!-- sky = selection / focus / links, green = the run action -->
    <Color x:Key="AccentColor">#FF38BDF8</Color>
    <Color x:Key="AccentDimColor">#FF0284C7</Color>
    <Color x:Key="ActionColor">#FF22C55E</Color>
    <Color x:Key="ActionHoverColor">#FF16A34A</Color>
    <Color x:Key="OnActionColor">#FF052E16</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="Bg4" Color="{StaticResource Bg4Color}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="BorderBrushMain" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="Fg" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="FgDim" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="FgMuted" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="Action" Color="{StaticResource ActionColor}" />
    <SolidColorBrush x:Key="ActionHover" Color="{StaticResource ActionHoverColor}" />
    <SolidColorBrush x:Key="OnAction" Color="{StaticResource OnActionColor}" />

    <!-- semantic -->
    <SolidColorBrush x:Key="Ok" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="Warn" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Danger" Color="#FFF87171" />
    <SolidColorBrush x:Key="Info" Color="#FF38BDF8" />
    <SolidColorBrush x:Key="Purple" Color="#FFC084FC" />

    <!-- translucent washes for chips and banners -->
    <SolidColorBrush x:Key="OkWash" Color="#FF4ADE80" Opacity="0.14" />
    <SolidColorBrush x:Key="WarnWash" Color="#FFFBBF24" Opacity="0.14" />
    <SolidColorBrush x:Key="DangerWash" Color="#FFF87171" Opacity="0.16" />
    <SolidColorBrush x:Key="AccentWash" Color="#FF38BDF8" Opacity="0.14" />
    <SolidColorBrush x:Key="ActionWash" Color="#FF22C55E" Opacity="0.14" />

    <!-- HTTP method colours -->
    <SolidColorBrush x:Key="MethodGET" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="MethodPOST" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="MethodPUT" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="MethodPATCH" Color="#FFC084FC" />
    <SolidColorBrush x:Key="MethodDELETE" Color="#FFF87171" />
    <SolidColorBrush x:Key="MethodHEAD" Color="#FF22D3EE" />
    <SolidColorBrush x:Key="MethodOPTIONS" Color="#FFF472B6" />

    <!-- timing waterfall segments -->
    <SolidColorBrush x:Key="TimingDns" Color="#FF818CF8" />
    <SolidColorBrush x:Key="TimingConnect" Color="#FF38BDF8" />
    <SolidColorBrush x:Key="TimingTls" Color="#FF2DD4BF" />
    <SolidColorBrush x:Key="TimingWait" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="TimingDownload" Color="#FF4ADE80" />

</ResourceDictionary>
