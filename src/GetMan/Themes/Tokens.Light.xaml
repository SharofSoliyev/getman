<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light tokens. Same keys as Tokens.Dark.xaml so the two swap at run time.
        Accents step one shade darker than the dark theme so they still clear 4.5:1 on white,
        and borders use slate-200/300 rather than a translucent white that would vanish.

        Contrast against Bg0 (#FFFFFF): Fg 17.9:1, FgDim 7.5:1, FgMuted 4.8:1.
    -->

    <Color x:Key="Bg0Color">#FFFFFFFF</Color>
    <Color x:Key="Bg1Color">#FFF8FAFC</Color>
    <Color x:Key="Bg2Color">#FFF1F5F9</Color>
    <Color x:Key="Bg3Color">#FFE7EDF4</Color>
    <Color x:Key="Bg4Color">#FFDCE5EF</Color>
    <Color x:Key="BorderSoftColor">#FFE2E8F0</Color>
    <Color x:Key="BorderColor">#FFCBD5E1</Color>

    <Color x:Key="TextColor">#FF0F172A</Color>
    <Color x:Key="TextDimColor">#FF475569</Color>
    <Color x:Key="TextMutedColor">#FF64748B</Color>

    <Color x:Key="AccentColor">#FF0284C7</Color>
    <Color x:Key="AccentDimColor">#FF075985</Color>
    <Color x:Key="ActionColor">#FF16A34A</Color>
    <Color x:Key="ActionHoverColor">#FF15803D</Color>
    <Color x:Key="OnActionColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <!-- Bg2 with the alpha a Mica backdrop needs; used for the app bar and the status
         strip only when the backdrop actually took, so it is never seen on its own. -->
    <SolidColorBrush x:Key="Bg2Veil" Color="#D9F1F5F9" />
    <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="Bg4" Color="{StaticResource Bg4Color}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="BorderBrushMain" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="Fg" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="FgDim" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="FgMuted" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="Action" Color="{StaticResource ActionColor}" />
    <SolidColorBrush x:Key="ActionHover" Color="{StaticResource ActionHoverColor}" />
    <SolidColorBrush x:Key="OnAction" Color="{StaticResource OnActionColor}" />

    <SolidColorBrush x:Key="Ok" Color="#FF15803D" />
    <SolidColorBrush x:Key="Warn" Color="#FFB45309" />
    <SolidColorBrush x:Key="Danger" Color="#FFDC2626" />
    <SolidColorBrush x:Key="Info" Color="#FF0284C7" />
    <SolidColorBrush x:Key="Purple" Color="#FF7E22CE" />

    <SolidColorBrush x:Key="OkWash" Color="#FF15803D" Opacity="0.12" />
    <SolidColorBrush x:Key="WarnWash" Color="#FFB45309" Opacity="0.12" />
    <SolidColorBrush x:Key="DangerWash" Color="#FFDC2626" Opacity="0.12" />
    <SolidColorBrush x:Key="AccentWash" Color="#FF0284C7" Opacity="0.12" />
    <SolidColorBrush x:Key="ActionWash" Color="#FF16A34A" Opacity="0.12" />

    <SolidColorBrush x:Key="MethodGET" Color="#FF15803D" />
    <SolidColorBrush x:Key="MethodPOST" Color="#FFB45309" />
    <SolidColorBrush x:Key="MethodPUT" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="MethodPATCH" Color="#FF7E22CE" />
    <SolidColorBrush x:Key="MethodDELETE" Color="#FFDC2626" />
    <SolidColorBrush x:Key="MethodHEAD" Color="#FF0E7490" />
    <SolidColorBrush x:Key="MethodOPTIONS" Color="#FFBE185D" />

    <SolidColorBrush x:Key="TimingDns" Color="#FF4F46E5" />
    <SolidColorBrush x:Key="TimingConnect" Color="#FF0284C7" />
    <SolidColorBrush x:Key="TimingTls" Color="#FF0D9488" />
    <SolidColorBrush x:Key="TimingWait" Color="#FFB45309" />
    <SolidColorBrush x:Key="TimingDownload" Color="#FF15803D" />


    <!-- ================================================ Fluent bridge ==== -->
    <!--
        WPF-UI reads its own resource names, so the Fluent controls are pointed at the
        GetMan tokens rather than left on their defaults - which are a #202020 surface and
        a salmon accent. These live in the theme dictionaries so a theme switch moves them
        too, and StaticResource works because the tokens above are already defined.
    -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource ActionColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource ActionHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource ActionHoverColor}" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource ActionColor}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource ActionHoverColor}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource ActionHoverColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource OnActionColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource OnActionColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="{StaticResource AccentColor}" />

    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

</ResourceDictionary>
