<Application x:Class="GetMan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:GetMan.Controls"
             xmlns:themes="clr-namespace:GetMan.Themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Fluent 2, from WPF-UI: the base control set. Themes/Controls.xaml sits on top
                    of it and has the last word on density, palette and motion. The accent brushes
                    are not set here because WPF-UI writes its own into Application.Resources at
                    load time; ThemeManager overwrites them once the app is up.
                -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />

                <ResourceDictionary Source="Themes/Typography.xaml" />
                <!-- Swapped at run time by ThemeManager. -->
                <ResourceDictionary Source="Themes/Tokens.Dark.xaml" />
                <themes:MotionResources />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ctl:InverseBoolConverter x:Key="InverseBool" />
            <ctl:BoolToVisibilityConverter x:Key="BoolToVis" />
            <ctl:NullToVisibilityConverter x:Key="NullToVis" />
            <ctl:CountToVisibilityConverter x:Key="CountToVis" />
            <ctl:EqualityConverter x:Key="Equality" />
            <ctl:EqualityToVisibilityConverter x:Key="EqualityToVis" />
            <ctl:MethodBrushConverter x:Key="MethodBrush" />
            <ctl:TestStatusBrushConverter x:Key="TestStatusBrush" />
            <ctl:TestStatusIconConverter x:Key="TestStatusIcon" />
            <ctl:LogLevelBrushConverter x:Key="LogLevelBrush" />
            <ctl:LogLevelIconConverter x:Key="LogLevelIcon" />
            <ctl:StatusBrushConverter x:Key="StatusBrush" />
            <ctl:NodeIconConverter x:Key="NodeIcon" />
            <ctl:BytesConverter x:Key="Bytes" />
            <ctl:MillisConverter x:Key="Millis" />
            <ctl:BoolToBrushConverter x:Key="BoolToBrush" />
            <ctl:DirtyMarkerConverter x:Key="DirtyMarker" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
