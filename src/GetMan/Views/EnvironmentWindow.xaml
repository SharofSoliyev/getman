<Window x:Class="GetMan.Views.EnvironmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GetMan.Services"
        xmlns:ctl="clr-namespace:GetMan.Controls"
        Title="Environments" Height="600" Width="1000"
        Background="{DynamicResource Bg1}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource BorderBrushMain}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{loc:T s.environments}" Style="{StaticResource SectionLabel}" Margin="14,14,0,8" />
                <ListBox Grid.Row="1" x:Name="EnvList" Margin="8,0" SelectionChanged="OnEnvSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           Text="{Binding Variables.Count}" Style="{StaticResource Caption}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="12,10">
                    <Button Content="{loc:T s.new_environment}" Click="OnAdd" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:T s.duplicate}" Click="OnDuplicate" MinWidth="82" Margin="0,0,6,0" />
                        <Button Content="{loc:T s.delete}" Click="OnDelete" MinWidth="70" Margin="0,0,6,0" />
                        <Button Content="{loc:T s.export}" Click="OnExport" MinWidth="70" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:T s.name}" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                    <TextBox x:Name="NameBox" Width="320" TextChanged="OnNameChanged" />
                    <CheckBox x:Name="ActiveBox" Content="{loc:T s.set_as_active_environment}" Margin="18,0,0,0" Click="OnSetActive" />
                </StackPanel>
            </StackPanel>

            <ctl:KeyValueGrid Grid.Row="1" x:Name="VarGrid" ShowDescription="True" />

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Text="{loc:T s.environment_variables_override_collection_va_84023}" />
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="{loc:T s.done}" MinWidth="90"
                        Style="{StaticResource PrimaryButton}" Click="OnClose" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
