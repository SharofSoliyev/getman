<Window x:Class="GetMan.Views.RunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GetMan.Services"
        Title="Collection runner" Height="700" Width="1100"
        Background="{DynamicResource Bg1}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- configuration -->
        <Border Grid.Column="0" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource BorderBrushMain}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="14,14,14,8">
                    <TextBlock x:Name="TargetName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{loc:T s.run_configuration}" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="{loc:T s.iterations}" Style="{StaticResource Caption}" Width="90" />
                        <TextBox x:Name="IterationsBox" Width="80" Text="1" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="{loc:T s.delay_ms}" Style="{StaticResource Caption}" Width="90" />
                        <TextBox x:Name="DelayBox" Width="80" Text="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="{loc:T s.data_file}" Style="{StaticResource Caption}" Width="90" />
                        <Button Content="{loc:T s.select}" Click="OnPickData" MinWidth="80" />
                    </StackPanel>
                    <TextBlock x:Name="DataInfo" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <CheckBox x:Name="StopOnFailure" Content="{loc:T s.stop_run_on_test_failure}" Margin="0,10,0,0" />
                    <CheckBox x:Name="KeepVariables" Content="{loc:T s.persist_variables_set_by_scripts}" Margin="0,6,0,0" IsChecked="True" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="14,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{loc:T s.requests}" Style="{StaticResource SectionLabel}" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="{loc:T s.all}" Style="{StaticResource LinkButton}" Click="OnSelectAll" />
                            <Button Content="{loc:T s.none}" Style="{StaticResource LinkButton}" Click="OnSelectNone" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox Grid.Row="1" x:Name="RequestList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Selected}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Method}" FontSize="9" FontWeight="Bold" MinWidth="42"
                                               Foreground="{Binding Method, Converter={StaticResource MethodBrush}}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="2" Margin="14,10">
                    <Button x:Name="RunButton" Content="{loc:T s.run}" Height="34" Style="{StaticResource PrimaryButton}" Click="OnRun" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- results -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource Bg2}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,34,0">
                        <TextBlock Text="{loc:T s.requests}" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TotalText" Text="0" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,34,0">
                        <TextBlock Text="{loc:T s.passed_tests}" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="PassedText" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ok}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,34,0">
                        <TextBlock Text="{loc:T s.failed_tests}" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="FailedText" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,34,0">
                        <TextBlock Text="{loc:T s.total_time}" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TimeText" Text="0 ms" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{loc:T s.status}" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="RunStatus" Text="{loc:T s.idle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource FgDim}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ProgressBar Grid.Row="1" x:Name="Progress" Height="3" Minimum="0" Maximum="100" Value="0" />

            <ScrollViewer Grid.Row="2" x:Name="ResultScroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Results" Margin="16,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Bg2}" CornerRadius="5" Padding="12,9" Margin="0,0,0,7">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Method}" FontSize="9.5" FontWeight="Bold"
                                                   MinWidth="46" Foreground="{Binding Method, Converter={StaticResource MethodBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Url}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,0,14,0"
                                                       Foreground="{Binding StatusCode, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Tests}" Margin="46,7,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Background="{Binding Status, Converter={StaticResource TestStatusBrush}}"
                                                            CornerRadius="3" Padding="5,0" Margin="0,0,9,0">
                                                        <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="#FF1B1B1D" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" />
                                                    <TextBlock Text="{Binding Message}" FontSize="11" Margin="10,0,0,0"
                                                               Foreground="{DynamicResource Danger}" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" Margin="46,6,0,0"
                                               TextWrapping="Wrap" FontSize="11.5"
                                               Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
