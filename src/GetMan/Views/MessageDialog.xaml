<Window x:Class="GetMan.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GetMan.Services"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        SizeToContent="Height" Width="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="OnDrag">

    <!-- A rounded card instead of the OS dialog, so it matches the rest of the app. -->
    <Border Margin="16" CornerRadius="12" Background="{DynamicResource Bg1}"
            BorderBrush="{DynamicResource BorderBrushMain}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,22,24,18">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconWell" Width="38" Height="38" CornerRadius="10"
                            VerticalAlignment="Top">
                        <materialDesign:PackIcon x:Name="Icon" Width="22" Height="22"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" MaxWidth="352">
                        <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>
                </StackPanel>

                <!-- Long lists (import warnings) get their own scroll area. -->
                <Border x:Name="DetailWell" Visibility="Collapsed" Margin="52,14,0,0"
                        CornerRadius="8" Background="{DynamicResource Bg0}" Padding="12,10"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="11.5"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource FgDim}" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource Bg2}" CornerRadius="0,0,11,11"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                    Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton" MinWidth="96" Margin="0,0,10,0"
                            Click="OnSecondary" Visibility="Collapsed" />
                    <Button x:Name="PrimaryButton" MinWidth="110" Style="{StaticResource PrimaryButton}"
                            Click="OnPrimary" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
