<UserControl x:Class="GetMan.Views.ResponseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:GetMan.Services"
             xmlns:ctl="clr-namespace:GetMan.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="StatChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg2}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ctl:HoverAssist.Scale" Value="1.05" />
        </Style>

        <!-- Played from the code-behind every time a response lands. -->
        <Storyboard x:Key="ResponseArrived">
            <DoubleAnimation Storyboard.TargetName="ResponseRoot" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="{StaticResource DurSlow}" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="ResponseRoot" Storyboard.TargetProperty="RenderTransform.Y"
                             From="14" To="0" Duration="{StaticResource DurPop}" EasingFunction="{StaticResource EaseOut}" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- empty state -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <ui:SymbolIcon Symbol="Send24" FontSize="52"
                                     Foreground="{DynamicResource Bg4}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:T s.send_a_request_to_see_the_response_here}" Style="{StaticResource Caption}"
                       Margin="0,14,0,0" HorizontalAlignment="Center" />
            <Border Background="{DynamicResource Bg2}" CornerRadius="5" Padding="9,3" Margin="0,10,0,0"
                    HorizontalAlignment="Center">
                <TextBlock Text="Ctrl + Enter" FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{DynamicResource FgMuted}" />
            </Border>
        </StackPanel>

        <Grid x:Name="ResponseRoot" Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
            <Grid.RenderTransform>
                <TranslateTransform Y="0" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- summary strip: four stat tiles plus the body actions -->
            <Border Grid.Row="0" Padding="18,10" Background="{DynamicResource Bg1}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,1">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="{loc:T s.status}" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusLine}" Foreground="{Binding StatusBrush}" Margin="7,0,0,0"
                                           FontSize="15" FontFamily="{StaticResource UiFontMedium}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="{loc:T s.time}" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding TimeLine}" FontSize="15"
                                       FontFamily="{StaticResource UiFontMedium}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="{loc:T s.size}" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SizeLine}" FontSize="15"
                                       FontFamily="{StaticResource UiFontMedium}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding TestResults.Count, Converter={StaticResource CountToVis}}">
                            <TextBlock Text="{loc:T s.tests}" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                            <TextBlock FontSize="15" FontFamily="{StaticResource UiFontMedium}"
                                       Text="{Binding TestSummary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FailedCount, Converter={StaticResource CountToVis}}" Value="Visible">
                                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Command="{Binding CopyResponseCommand}"
                                AutomationProperties.Name="{loc:T s.copy_response_body}" ToolTip="{loc:T s.copy_body}">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="17" />
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Command="{Binding SaveResponseCommand}"
                                AutomationProperties.Name="{loc:T s.save_response_body}" ToolTip="{loc:T s.save_body_to_a_file}">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="17" />
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Command="{Binding ClearResponseCommand}"
                                AutomationProperties.Name="{loc:T s.clear_response}" ToolTip="{loc:T s.clear_the_response}">
                            <ui:SymbolIcon Symbol="Eraser24" FontSize="17" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- error banner sits under the tiles so a failure is never a colour-only cue -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Background="{DynamicResource DangerWash}"
                    BorderBrush="{DynamicResource Danger}" BorderThickness="0,0,0,2" Padding="18,8"
                    Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="16"
                                             Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Danger}" Margin="8,0,0,0"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1" Style="{StaticResource SubTabControl}"
                        SelectedIndex="{Binding ActiveResponseIndex, Mode=TwoWay}">
                <TabItem Header="{loc:T s.body}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="16,9,16,7">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <RadioButton Content="{loc:T s.pretty}" GroupName="respview" Margin="0,0,16,0"
                                             IsChecked="{Binding ResponseView, Converter={StaticResource Equality}, ConverterParameter=Pretty, Mode=TwoWay}" />
                                <RadioButton Content="{loc:T s.raw}" GroupName="respview" Margin="0,0,16,0"
                                             IsChecked="{Binding ResponseView, Converter={StaticResource Equality}, ConverterParameter=Raw, Mode=TwoWay}" />
                                <RadioButton Content="{loc:T s.preview}" GroupName="respview"
                                             IsChecked="{Binding ResponseView, Converter={StaticResource Equality}, ConverterParameter=Preview, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"
                                       Text="{Binding Response.ContentType}" Style="{StaticResource Caption}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <ctl:CodeEditor x:Name="BodyEditor" IsReadOnly="True"
                                            BoundText="{Binding ResponseBody, Mode=OneWay}"
                                            SyntaxLanguage="{Binding ResponseLanguage}" />
                            <ScrollViewer x:Name="ImageHost" Visibility="Collapsed" Background="{DynamicResource Bg0}"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image Source="{Binding ResponseImage}" Stretch="None" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="16" />
                            </ScrollViewer>
                            <Border x:Name="PreviewHost" Visibility="Collapsed" Background="White">
                                <WebBrowser x:Name="Browser" />
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T s.cookies}" />
                            <Border Style="{StaticResource CountPill}"
                                    Visibility="{Binding ResponseCookies.Count, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{Binding ResponseCookies.Count}" Style="{StaticResource PillText}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid ItemsSource="{Binding ResponseCookies}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T s.name}" Binding="{Binding Name}" Width="1*" />
                            <DataGridTextColumn Header="{loc:T s.value}" Binding="{Binding Value}" Width="2*" />
                            <DataGridTextColumn Header="{loc:T s.domain}" Binding="{Binding Domain}" Width="1*" />
                            <DataGridTextColumn Header="{loc:T s.path}" Binding="{Binding Path}" Width="80" />
                            <DataGridTextColumn Header="{loc:T s.expires}" Binding="{Binding Expires}" Width="1*" />
                            <DataGridCheckBoxColumn Header="{loc:T s.httponly}" Binding="{Binding HttpOnly}" Width="76" />
                            <DataGridCheckBoxColumn Header="{loc:T s.secure}" Binding="{Binding Secure}" Width="66" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T s.headers}" />
                            <Border Style="{StaticResource CountPill}"
                                    Visibility="{Binding ResponseHeaders.Count, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{Binding ResponseHeaders.Count}" Style="{StaticResource PillText}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <DataGrid ItemsSource="{Binding ResponseHeaders}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T s.key}" Binding="{Binding Key}" Width="1*"
                                                FontFamily="{StaticResource MonoFont}" />
                            <DataGridTextColumn Header="{loc:T s.value}" Binding="{Binding Value}" Width="2.4*"
                                                FontFamily="{StaticResource MonoFont}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T s.tests}" />
                            <Border Style="{StaticResource CountPill}"
                                    Visibility="{Binding TestResults.Count, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{Binding TestSummary}" Style="{StaticResource PillText}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding TestResults.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                            <ui:SymbolIcon Symbol="Beaker24" FontSize="36" HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource Bg4}" />
                            <TextBlock Text="{loc:T s.this_request_has_no_tests}" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TestResults}" Margin="16,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PanelCard}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon FontSize="18" VerticalAlignment="Center"
                                                                             Symbol="{Binding Status, Converter={StaticResource TestStatusIcon}}"
                                                                             Foreground="{Binding Status, Converter={StaticResource TestStatusBrush}}" />
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="10,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" FontSize="11.5" Margin="28,5,0,0"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Danger}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="{loc:T s.console}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ConsoleEntries}" Margin="16,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat=HH:mm:ss.fff}"
                                                   Foreground="{DynamicResource FgMuted}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" VerticalAlignment="Top" />
                                        <ui:SymbolIcon Grid.Column="1" FontSize="14" Margin="10,1,10,0"
                                                                 VerticalAlignment="Top"
                                                                 Symbol="{Binding Level, Converter={StaticResource LogLevelIcon}}"
                                                                 Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Top" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:T s.timing}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,16" MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="{loc:T s.waterfall}" Style="{StaticResource SectionLabel}" />
                            <Border Style="{StaticResource PanelCard}" Padding="16,14">
                                <StackPanel>
                                    <!--
                                        Part-to-whole of the total duration. A stacked bar rather than a pie:
                                        easier to read at these proportions and it degrades to the table below.
                                    -->
                                    <Border CornerRadius="5" ClipToBounds="True" Height="26"
                                            Background="{DynamicResource Bg3}">
                                        <Grid x:Name="TimingBar" />
                                    </Border>
                                    <WrapPanel x:Name="TimingLegend" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:T s.connection}" Style="{StaticResource SectionLabel}" Margin="0,10,0,4" />
                            <Border Style="{StaticResource PanelCard}" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{loc:T s.dns_lookup}" Style="{StaticResource Caption}" Margin="0,3" />
                                    <TextBlock Grid.Column="1" Margin="0,3" FontFamily="{StaticResource MonoFont}"
                                               Text="{Binding Response.Timing.DnsMs, Converter={StaticResource Millis}}" />
                                    <TextBlock Grid.Row="1" Text="{loc:T s.tcp_handshake}" Style="{StaticResource Caption}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3" FontFamily="{StaticResource MonoFont}"
                                               Text="{Binding Response.Timing.ConnectMs, Converter={StaticResource Millis}}" />
                                    <TextBlock Grid.Row="2" Text="{loc:T s.tls_handshake}" Style="{StaticResource Caption}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3" FontFamily="{StaticResource MonoFont}"
                                               Text="{Binding Response.Timing.TlsMs, Converter={StaticResource Millis}}" />
                                    <TextBlock Grid.Row="3" Text="{loc:T s.time_to_first_byte}" Style="{StaticResource Caption}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3" FontFamily="{StaticResource MonoFont}"
                                               Text="{Binding Response.Timing.FirstByteMs, Converter={StaticResource Millis}}" />
                                    <TextBlock Grid.Row="4" Text="{loc:T s.download}" Style="{StaticResource Caption}" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,3" FontFamily="{StaticResource MonoFont}"
                                               Text="{Binding Response.Timing.DownloadMs, Converter={StaticResource Millis}}" />
                                    <TextBlock Grid.Row="5" Text="{loc:T s.total}" Style="{StaticResource Caption}" Margin="0,3" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,3" Foreground="{DynamicResource Accent}"
                                               FontFamily="{StaticResource MonoFont}"
                                               Text="{Binding Response.Timing.TotalMs, Converter={StaticResource Millis}}" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{loc:T s.response}" Style="{StaticResource SectionLabel}" Margin="0,10,0,4" />
                            <Border Style="{StaticResource PanelCard}" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{loc:T s.http_version}" Style="{StaticResource Caption}" Margin="0,3" />
                                    <TextBlock Grid.Column="1" Margin="0,3" FontFamily="{StaticResource MonoFont}"
                                               Text="{Binding Response.HttpVersion}" />
                                    <TextBlock Grid.Row="1" Text="{loc:T s.body_size}" Style="{StaticResource Caption}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3" FontFamily="{StaticResource MonoFont}"
                                               Text="{Binding Response.BodyBytes, Converter={StaticResource Bytes}}" />
                                    <TextBlock Grid.Row="2" Text="{loc:T s.headers_size}" Style="{StaticResource Caption}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3" FontFamily="{StaticResource MonoFont}"
                                               Text="{Binding Response.HeaderBytes, Converter={StaticResource Bytes}}" />
                                    <TextBlock Grid.Row="3" Text="{loc:T s.final_url}" Style="{StaticResource Caption}" Margin="0,3"
                                               VerticalAlignment="Top" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3" TextWrapping="Wrap" FontSize="11.5"
                                               FontFamily="{StaticResource MonoFont}" Text="{Binding Response.FinalUrl}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
