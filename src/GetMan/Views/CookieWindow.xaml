<Window x:Class="GetMan.Views.CookieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GetMan.Services"
        Title="Cookies" Height="500" Width="880"
        Background="{DynamicResource Bg1}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:T s.cookie_jar}" Style="{StaticResource SectionLabel}" />

        <DataGrid Grid.Row="1" x:Name="Grid" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T s.domain}" Binding="{Binding Domain}" Width="1.2*" />
                <DataGridTextColumn Header="{loc:T s.name}" Binding="{Binding Name}" Width="1*" />
                <DataGridTextColumn Header="{loc:T s.value}" Binding="{Binding Value}" Width="2*" />
                <DataGridTextColumn Header="{loc:T s.path}" Binding="{Binding Path}" Width="80" />
                <DataGridTextColumn Header="{loc:T s.expires}" Binding="{Binding Expires}" Width="1.2*" />
                <DataGridCheckBoxColumn Header="{loc:T s.secure}" Binding="{Binding Secure}" Width="60" />
                <DataGridCheckBoxColumn Header="{loc:T s.httponly}" Binding="{Binding HttpOnly}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="{loc:T s.clear_all_cookies}" Click="OnClear" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="{loc:T s.refresh}" Margin="0,0,8,0" Click="OnRefresh" />
                <Button Content="{loc:T s.close}" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="OnClose" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
