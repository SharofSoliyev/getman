<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="JsonDark" extensions=".json" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Bool" foreground="#569CD6" />
  <Color name="Number" foreground="#B5CEA8" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Null" foreground="#569CD6" />
  <Color name="FieldName" foreground="#9CDCFE" />
  <Color name="Punctuation" foreground="#D4D4D4" />

  <RuleSet name="String">
    <Span begin="\\" end="." />
  </RuleSet>

  <RuleSet>
    <Keywords color="Bool">
      <Word>true</Word>
      <Word>false</Word>
    </Keywords>
    <Keywords color="Null">
      <Word>null</Word>
    </Keywords>

    <Span color="FieldName" ruleSet="String" multiline="false">
      <Begin>"(?=[^"]*"\s*:)</Begin>
      <End>"</End>
    </Span>

    <Span color="String" ruleSet="String" multiline="false">
      <Begin>"</Begin>
      <End>"</End>
    </Span>

    <Rule color="Number">
      (?&lt;!\w)[\-]?\d+(\.\d+)?([eE][\+\-]?\d+)?(?!\w)
    </Rule>

    <Rule color="Punctuation">
      [{}\[\],:]
    </Rule>
  </RuleSet>
</SyntaxDefinition>
