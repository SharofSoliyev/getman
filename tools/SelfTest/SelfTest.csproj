<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GetMan.SelfTest</RootNamespace>
    <AssemblyName>GetMan.SelfTest</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\GetMan\Models\**\*.cs" LinkBase="Models" />
    <Compile Include="..\..\src\GetMan\Services\**\*.cs" LinkBase="Services" />
    <!-- Localization.cs is XAML plumbing (MarkupExtension, Binding); these tests run without WPF. -->
    <Compile Remove="..\..\src\GetMan\Services\Localization.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
